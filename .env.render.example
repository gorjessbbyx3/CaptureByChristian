# Production Environment Variables for Render
# Copy these to your Render service environment variables

# Application Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (Get from Render PostgreSQL service)
DATABASE_URL=postgresql://postgres:password@host:5432/capturedcollective

# Security
SESSION_SECRET=your-super-secure-session-secret-change-this

# API Keys (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Twilio (Optional - for SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Replit AI (Optional - alternative to OpenAI)
REPLIT_AI_TOKEN=your-replit-token

# File Storage (Optional - for production file uploads)
# CLOUDINARY_CLOUD_NAME=your-cloudinary-name
# CLOUDINARY_API_KEY=your-cloudinary-key
# CLOUDINARY_API_SECRET=your-cloudinary-secret

# Monitoring (Optional)
# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=info