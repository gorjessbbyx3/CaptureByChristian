{
  "name": "property-intelligence-app",
  "version": "1.0.0",
  "description": "Intelligent property analysis system that deduces unknown property information from known data",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc && vite build",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "mcp:install": "npm run mcp:install:cloud && npm run mcp:install:github",
    "mcp:install:cloud": "npx @modelcontextprotocol/create-server cloud-mcp-server",
    "mcp:install:github": "npx @modelcontextprotocol/create-server github-mcp-server",
    "mcp:start": "concurrently \"npm run mcp:cloud\" \"npm run mcp:github\"",
    "mcp:cloud": "node mcp-servers/cloud/dist/index.js",
    "mcp:github": "node mcp-servers/github/dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^20.0.0",
    "@types/stripe": "^8.0.416",
    "@vitejs/plugin-react": "^4.0.0",
    "axios": "^1.5.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.19.0",
    "drizzle-orm": "^0.28.0",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "node-cron": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "sqlite3": "^5.1.6",
    "stripe": "^18.3.0",
    "tailwindcss": "^3.3.0",
    "vite": "^4.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.45.0",
    "postcss": "^8.4.0",
    "tsx": "^3.12.0",
    "typescript": "^5.0.0",
    "vitest": "^0.34.0"
  },
  "keywords": [
    "property",
    "real-estate",
    "inference",
    "analysis",
    "mcp",
    "ai"
  ],
  "author": "Property Intelligence Team",
  "license": "MIT"
}
