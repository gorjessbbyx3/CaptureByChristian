{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "removeComments": true,
    "allowImportingTsExtensions": false,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false
  },
  "include": [
    "server/index.ts",
    "server/routes.ts",
    "server/storage.ts",
    "server/db.ts",
    "server/openai.ts",
    "server/pdf-generator.ts",
    "server/database-init.ts",
    "server/twilio.ts",
    "shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "client",
    "**/*.test.ts",
    "**/*.spec.ts",
    "server/vite.ts",
    "vite.config.ts"
  ]
}